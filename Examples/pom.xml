<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aspose.cloud.cells</groupId>
  <artifactId>aspose-cells-cloud-examples</artifactId>
  <version>26.11.0</version>
  <packaging>jar</packaging>

  <name>Aspose.Cells Cloud SDK for Java examples</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Must match the SDK's maven.compiler.release. -->
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Examples are now in the same directory as test data files. -->
    <example.workingDirectory>${project.basedir}</example.workingDirectory>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.aspose</groupId>
      <artifactId>aspose-cells-cloud</artifactId>
      <version>26.11.0</version>
    </dependency>
  </dependencies>

  <build>
    <!-- The examples are flat .java files, not a src/main/java tree. -->
    <sourceDirectory>${project.basedir}</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <!-- Optional: run one example with
           mvn -q -f examples/pom.xml exec:exec "-Dexample.mainClass=com.aspose.cells.cloud.examples.QuickStartExample"
           exec:exec forks a JVM so workingDirectory is honored; the examples
           then find the fixtures in testdata/ by their bare file names. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <workingDirectory>${example.workingDirectory}</workingDirectory>
          <arguments>
            <argument>-classpath</argument>
            <classpath/>
            <argument>${example.mainClass}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
