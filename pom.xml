<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aspose</groupId>
  <artifactId>aspose-cells-cloud</artifactId>
  <version>26.11.0</version>
  <packaging>jar</packaging>

  <name>Aspose.Cells Cloud SDK for Java</name>
  <description>Aspose.Cells Cloud SDK for Java, generated from aspose.cells.cloud.specification.json</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Dependency versions: kept in sync with what the generated code and the
         hand-written client infrastructure actually import, preferring versions
         already present in the local ~/.m2 repository so `mvn -o` works. -->
    <gson.version>2.8.9</gson.version>
    <swagger-annotations.version>1.5.15</swagger-annotations.version>
    <okhttp.version>4.11.0</okhttp.version>
    <jackson.version>2.15.2</jackson.version>
    <junit-jupiter.version>5.10.2</junit-jupiter.version>
  </properties>

  <dependencies>
    <!-- Generated models: @SerializedName wire-name annotations. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>
    <!-- Generated models: @ApiModelProperty annotations. -->
    <dependency>
      <groupId>io.swagger</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>${swagger-annotations.version}</version>
    </dependency>
    <!-- Client infrastructure (CellsCloudClient): okhttp3 HTTP client. -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>${okhttp.version}</version>
    </dependency>
    <!-- Client infrastructure (JsonUtil): Jackson ObjectMapper + JavaTimeModule. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- Smoke tests: JUnit 5. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Plugin versions pinned to releases cached in ~/.m2 so the offline
           verify (`mvn -o -q -DskipTests compile` / `mvn -o -q test`) never
           needs to resolve plugin metadata. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
      </plugin>
    </plugins>
  </build>
</project>
